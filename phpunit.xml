<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory="storage/framework/phpunit"
         cacheResult="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force: иначе PHPUnit не перебивает DB_* из php-fpm и RefreshDatabase идёт в боевой Postgres -->
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- иначе config:cache на боевом сервере подсовывает pgsql вместо sqlite :memory: -->
        <env name="APP_CONFIG_CACHE" value="storage/framework/testing/no-config.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value="storage/framework/testing/no-routes.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value="storage/framework/testing/no-events.php" force="true"/>
        <env name="APP_PACKAGES_CACHE" value="storage/framework/testing/no-packages.php" force="true"/>
        <env name="APP_SERVICES_CACHE" value="storage/framework/testing/no-services.php" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DATABASE_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="STORE_AVITO_CLIENT_ID" value="" force="true"/>
        <env name="STORE_AVITO_CLIENT_SECRET" value="" force="true"/>
        <env name="STORE_AVITO_USER_ID" value="" force="true"/>
        <env name="YOOKASSA_SHOP_ID" value="" force="true"/>
        <env name="YOOKASSA_SECRET_KEY" value="" force="true"/>
        <env name="DEEPSEEK_API_KEY" value="" force="true"/>
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <env name="YANDEX_SPEECHKIT_API_KEY" value="" force="true"/>
        <env name="AI_ASSISTANT_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
