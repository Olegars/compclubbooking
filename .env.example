APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Клиентский Android APK (самообновление: GET /app.json)
CLIENT_APP_VERSION_CODE=2
CLIENT_APP_VERSION_NAME=1.1.0

# Публичные данные клуба для лендинга и футера (пустые блоки не выводятся)
CLUB_CITY=
CLUB_ADDRESS=
CLUB_HOURS="Круглосуточно, без перерывов"
CLUB_PHONE=
CLUB_MAP_URL=
CLUB_TELEGRAM=
CLUB_VK=
CLUB_DISCORD=
CLUB_MIN_AGE=14

# Юридическая информация (обязательна при приёме платежей)
CLUB_LEGAL_ENTITY=
CLUB_LEGAL_INN=
CLUB_OFFER_URL=
CLUB_PRIVACY_URL=
CLUB_RULES_URL=

# ЮKassa (shopId + секретный ключ из ЛК → Интеграция → Ключи API)
# Тестовый ключ начинается с test_, боевой — с live_
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Webhook URL в ЛК ЮKassa: {APP_URL}/api/billing/yookassa/webhook

CLUB_SEO_TITLE="Sector 0451 — киберспортивный клуб"
CLUB_SEO_DESCRIPTION="Бронирование игровых мест онлайн: выберите место на карте клуба, время и тариф. Оплата и вход по PIN-коду."

# Бонус за отзыв (Яндекс.Карты / 2ГИС)
CLUB_YANDEX_ORG_ID=
CLUB_YANDEX_MAPS_URL=
CLUB_2GIS_FIRM_ID=
CLUB_2GIS_URL=
CLUB_2GIS_API_KEY=
CLUB_REVIEW_BONUS_AMOUNT=100
CLUB_REVIEW_MATCH_THRESHOLD=0.9
CLUB_REVIEW_MIN_TEXT_LENGTH=40
CLUB_REVIEW_PENDING_TTL_DAYS=30
CLUB_REVIEW_FETCH_PAGES=5
CLUB_REVIEW_PAGE_SIZE=50
CLUB_REVIEW_REQUIRE_FIVE_STARS=true

# Питание ПК / WOL-релей (MikroTik pull)
CLUB_POWER_WARMUP_MINUTES=30
# Мягкое ожидание опоздавшего (мин) без списания, если нет следующей брони на ПК
CLUB_LATE_START_GRACE_MINUTES=30
# Дефолт: самоотмена брони не позднее чем за N минут до старта (админка может переопределить)
CLUB_CANCEL_BEFORE_MINUTES=120
CLUB_POWER_HEARTBEAT_STALE_SECONDS=90
CLUB_POWER_WOL_TIMEOUT_SECONDS=180
CLUB_WOL_RELAY_TOKEN=

# DMX / Art-Net свет комнаты (PC Shell шлёт UDP, облако только desired)
# LIGHT_ARTNET_PORT=6454
# LIGHT_MANUAL_COOLDOWN_SEC=2
# LIGHT_AUTO_APPLY_COOLDOWN_SEC=5
# LIGHT_DEFAULT_BRIGHTNESS=80
# LIGHT_RAINBOW_PERIOD_MS=8000

# Кухонный ESC/POS чек-ордер (один Ethernet-принтер :9100)
# Облако кладёт задание в очередь при заказе; агент в LAN (scripts/kitchen-print-agent.ps1) забирает и печатает.
KITCHEN_PRINT_ENABLED=false
# Пусто → CLUB_WOL_RELAY_TOKEN
KITCHEN_PRINT_RELAY_TOKEN=
# Подсказка для агента (на машине агента задайте те же или свои)
KITCHEN_PRINTER_HOST=192.168.1.50
KITCHEN_PRINTER_PORT=9100

# Hikvision NVR метки (DS-7764NI-M4): очередь в облаке, LAN-агент scripts/hikvision-marker-agent.ps1
# Пусто → CLUB_WOL_RELAY_TOKEN. URL/логин/пароль NVR — в админке /admin/video-surveillance.
VIDEO_MARKER_RELAY_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Гостевой Wi-Fi (QR → /wifi/join в walled garden → MikroTik grant по MAC)
# На Hotspot белите APP_URL (или только /wifi/* и /api/wifi/authorize) до полного интернета.
WIFI_ACCESS_ENABLED=false
WIFI_STATION_CODE=club
WIFI_SESSION_HOURS=12
# Токен pull для MikroTik (пусто → CLUB_WOL_RELAY_TOKEN)
WIFI_RELAY_TOKEN=

# Голосовой компаньон Shell (Grave/Ё): Yandex SpeechKit (STT+TTS) + LLM (DeepSeek)
# Операционные ключи/промпты/голос и вкл/выкл — в админке /admin/ai-assistant (БД).
# AI_ASSISTANT_ENABLED больше не блокирует шел; оставлен для совместимости.
AI_ASSISTANT_ENABLED=true
AI_SPEECH_PROVIDER=yandex
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=
YANDEX_TTS_VOICE=alena
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_STT_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=nova
AI_ASSISTANT_MAX_AUDIO_KB=5120
AI_ASSISTANT_MAX_REPLY_CHARS=420
AI_ASSISTANT_RATE_LIMIT=8
AI_ASSISTANT_HTTP_TIMEOUT=60

# Фискализация (KkmServer). Пополнение → аванс; бронь/магазин с баланса → зачёт аванса.
FISCAL_ENABLED=false
KKM_SERVER_URL=http://127.0.0.1:5893/Execute
KKM_SERVER_USER=Admin
KKM_SERVER_PASS=
KKM_NUM_DEVICE=0
KKM_INN_KASSA=
KKM_CASHIER_NAME=
KKM_NOT_PRINT=false
KKM_TAX=-1
KKM_TIMEOUT=15

# USB check_build.exe — сверка сборки ПК с заказом магазина
# Заголовок: Authorization: Bearer {token} или X-Build-Verify-Token
STORE_BUILD_VERIFY_TOKEN=
STORE_BUILD_VERIFY_UPDATE_NAMES=true
STORE_WARRANTY_MONTHS=12
STORE_REPAIR_DAYS=45

# API поставщика (QuickFox) — сметы / закупка комплектующих
# DOMAIN без /api/2 (клиент добавляет сам): https://b2b.example.ru
STORE_QUICKFOX_DOMAIN=
STORE_QUICKFOX_LOGIN=
STORE_QUICKFOX_PASSWORD=
STORE_QUICKFOX_CATALOG_TREE=/download/catalog/json/catalog_tree_9.json
STORE_QUICKFOX_PRODUCTS=/download/catalog/json/products_9.json
# Опционально: id категорий через запятую (процессоры и т.п.), иначе весь каталог
STORE_QUICKFOX_CATEGORY_IDS=
